# SQLite database is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Generate a long random value for every deployment.
SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: required only when password-reset email delivery is enabled.
RESEND_API_KEY=""

# Optional seed overrides. Required if you run the seed with NODE_ENV=production.
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_STUDENT_NAME="Student User"
SEED_STUDENT_EMAIL="student@example.com"
SEED_STUDENT_PASSWORD="replace-with-a-strong-password"
