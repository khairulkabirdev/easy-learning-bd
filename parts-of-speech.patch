+// Subject-level Parts of Speech exercises are stored separately from other grammar sections.
+model SubjectPartsOfSpeechBlock {
+  id             String   @id @default(cuid())
+  classId        String
+  subjectId      String
+  kind           String   @default("parts-of-speech")
+  boardId        String?
+  academicYearId String?
+  title          String   @default("")
+  instruction    String   @default("")
+  details        String   @default("")
+  documentJson   String   @default("{}")
+  sortOrder      Int      @default(0)
+  organizationId String
+  createdBy      String
+  updatedBy      String
+  createdAt      DateTime @default(now())
+  updatedAt      DateTime @updatedAt
+
+  @@index([organizationId, classId, subjectId, kind, sortOrder])
+  @@index([organizationId, boardId, academicYearId])
+}
