  id             String   @id @default(cuid())
  year           Int
  isActive       Boolean  @default(true)
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, year])
  @@index([organizationId, isActive, year])
}
