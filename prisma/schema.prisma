model UnseenComposition {
  id             String   @id @default(cuid())
  classId        String
  subjectId      String
  title          String
  documentJson   String   @default("{\"version\":1,\"blocks\":[]}")
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([organizationId, classId, subjectId])
}

model ContentBlock {
  id                           String   @id @default(cuid())
  contentId                    String
  kind                         String
  sortOrder                    Int      @default(0)
  boardId                      String?
  academicYearId               String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  content                      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  paragraph                    Paragraph?
  vocabulary                   Vocabulary?
  synonymsAntonyms             SynonymsAntonyms?
  gapFillExercise              GapFillExercise?
  gapFillFirstPaper            GapFillFirstPaper?
  gapFillSecondPaper           GapFillSecondPaper?
  mcqSection                   McqSection?
  questionAnswerExercise       QuestionAnswerExercise?
  tableCompletionExercise      TableCompletionExercise?
  columnMatchingExercise       ColumnMatchingExercise?
  rearrangeSentenceExercise     RearrangeSentenceExercise?
  questionFromPoems            QuestionFromPoems?
  questionFromStory            QuestionFromStory?
  trueFalseExercise            TrueFalseExercise?
  informationTransfer          InformationTransfer?
  substitutionTable            SubstitutionTable?
  rightFormOfVerb              RightFormOfVerb?
  narration                    Narration?
  changingSentence             ChangingSentence?
  punctuationAndCapitalization PunctuationAndCapitalization?
  preposition                  Preposition?
  suffixAndPrefix              SuffixAndPrefix?
  tagQuestion                  TagQuestion?
  connector                    Connector?
  seenPassageOne               SeenPassageOne?
  seenPassageTwo               SeenPassageTwo?

  @@index([contentId, sortOrder])
  @@index([boardId, academicYearId])
}

model Paragraph {
  id             String   @id @default(cuid())
  contentBlockId String   @unique
  contentId      String
  classId        String
  subjectId      String
  unitId         String
  lessonId       String
  topicId        String?
  body           String   @default("")
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@index([organizationId, contentId])
}

model Vocabulary {
  id             String   @id @default(cuid())
  contentBlockId String   @unique
  contentId      String
  classId        String
  subjectId      String
  unitId         String
  lessonId       String
  topicId        String?
  passage        String   @default("")
  passageSource  String   @default("manual")
  paragraphBlockId String?
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentBlock   ContentBlock     @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  entries        VocabularyEntry[]

  @@index([organizationId, contentId])
}

model VocabularyEntry {
  id             String   @id @default(cuid())
  vocabularyId   String
  word           String   @default("")
  meaning        String   @default("")
  imageUrl       String   @default("")
  imagePath      String   @default("")
  sortOrder      Int      @default(0)
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  vocabulary     Vocabulary    @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  uploadedFiles  UploadedFile[]

  @@index([vocabularyId, sortOrder])
  @@index([organizationId])
}

model UploadedFile {
  id                 String   @id @default(cuid())
  purpose            String   @default("")
  ownerType          String   @default("")
  ownerId            String   @default("")
  vocabularyEntryId  String?
  url                String   @default("")
  path               String   @default("")
  originalName       String   @default("")
  sourceMimeType     String   @default("")
  mimeType           String   @default("")
  extension          String   @default("")
  sizeBytes          Int      @default(0)
  width              Int      @default(0)
  height             Int      @default(0)
  checksumSha256     String   @default("")
  status             String   @default("active")
  isCurrent          Boolean  @default(true)
  replacedAt         DateTime?
  deletedAt          DateTime?
  storageDeletedAt   DateTime?
  organizationId     String
  createdBy          String
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  vocabularyEntry    VocabularyEntry? @relation(fields: [vocabularyEntryId], references: [id], onDelete: SetNull)

  @@index([vocabularyEntryId, isCurrent, status])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, ownerType, ownerId])
  @@index([path])
}

