generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  student
  teacher
}

enum PublishStatus {
  draft
  published
  inactive
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole
  profileImage   String?
  phone          String?
  district       String?
  institutionName String?
  instituteType  String?
  academicYear   String?
  rollNumber     String?
  section        String?
  groupName      String?
  designation    String?
  subject        String?
  experience     String?
  classId        String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  class               Class?                @relation("StudentClass", fields: [classId], references: [id], onDelete: SetNull)
  sessions            AuthSession[]         @relation("UserSessions")
  passwordResetTokens PasswordResetToken[]  @relation("UserPasswordResetTokens")

  @@index([organizationId, role])
  @@index([classId])
}


model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime
  createdAt  DateTime @default(now())

  user       User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt])
}

model AuthEmailSetting {
  id              String   @id @default(cuid())
  senderName      String   @default("")
  senderEmail     String   @default("")
  appBaseUrl      String   @default("")
  resetEmailEnabled Boolean @default(false)
  organizationId  String   @unique
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  userName       String
  action         String
  entityName     String
  entityId       String
  changes        String
  organizationId String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityName, entityId])
}

model Class {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  code           String        @default("")
  description    String        @default("")
  status         PublishStatus @default(published)
  sortOrder      Int           @default(0)
  iconType       String        @default("none")
  iconLibrary    String        @default("")
  iconName       String        @default("")
  iconColor      String        @default("")
  imagePath      String        @default("")
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subjects       Subject[]
  units          Unit[]
  contents       Content[]
  unseenCompositions UnseenComposition[]
  students       User[]        @relation("StudentClass")

  @@index([organizationId, status, sortOrder])
}

model Subject {
  id             String        @id @default(cuid())
  classId        String
  name           String
  slug           String        @unique
  code           String        @default("")
  description    String        @default("")
  status         PublishStatus @default(published)
  sortOrder      Int           @default(0)
  iconType       String        @default("none")
  iconLibrary    String        @default("")
  iconName       String        @default("")
  iconColor      String        @default("")
  imagePath      String        @default("")
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  units          Unit[]
  contents       Content[]
  unseenCompositions UnseenComposition[]

  @@index([organizationId, classId, status, sortOrder])
}

model Unit {
  id             String        @id @default(cuid())
  classId        String
  subjectId      String
  title          String
  slug           String        @unique
  unitNumber     String        @default("")
  description    String        @default("")
  status         PublishStatus @default(published)
  sortOrder      Int           @default(0)
  iconType       String        @default("none")
  iconLibrary    String        @default("")
  iconName       String        @default("")
  iconColor      String        @default("")
  imagePath      String        @default("")
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  contents       Content[]

  @@index([organizationId, classId, subjectId, status, sortOrder])
}

model Lesson {
  id               String        @id @default(cuid())
  unitId           String
  title            String
  slug             String        @unique
  lessonNumber     String        @default("")
  shortDescription String        @default("")
  status           PublishStatus @default(published)
  sortOrder        Int           @default(0)
  iconType         String        @default("none")
  iconLibrary      String        @default("")
  iconName         String        @default("")
  iconColor        String        @default("")
  imagePath        String        @default("")
  organizationId   String
  createdBy        String
  updatedBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  unit             Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  topics           Topic[]
  contents         Content[]

  @@index([organizationId, unitId, status, sortOrder])
}

model Topic {
  id               String        @id @default(cuid())
  lessonId         String
  title            String
  slug             String        @unique
  topicNumber      String        @default("")
  shortDescription String        @default("")
  status           PublishStatus @default(published)
  sortOrder        Int           @default(0)
  iconType         String        @default("none")
  iconLibrary      String        @default("")
  iconName         String        @default("")
  iconColor        String        @default("")
  imagePath        String        @default("")
  organizationId   String
  createdBy        String
  updatedBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contents         Content[]

  @@index([organizationId, lessonId, status, sortOrder])
}

model Content {
  id             String   @id @default(cuid())
  title          String   @default("")
  classId        String
  subjectId      String
  unitId         String
  lessonId       String
  topicId        String?
  organizationId String
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  topic          Topic?   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  blocks         ContentBlock[]

  @@unique([classId, subjectId, unitId, lessonId, topicId, organizationId])

  @@index([organizationId, classId, subjectId, unitId, lessonId])
  @@index([topicId])
}


