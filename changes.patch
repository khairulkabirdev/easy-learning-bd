+
+/** Each fixed section uses the passage block saved in the SAME model-question set.
+ * The parent is the existing native ContentBlock; no extra relation table is required.
+ */
+export const CLASS_6_7_MODEL_QUESTION_PASSAGE_PARENTS = {
+  mcq: "seen-passage-one",
+  "question-answer": "seen-passage-one",
+  "gap-fill-first-paper": "seen-passage-two",
+  "synonyms-antonyms": "seen-passage-two",
+  "information-transfer": "paragraph",
+  "true-false": "paragraph",
+  "writing-summary": "paragraph",
+} as const;
+
+export function getFixedPassageParentKind(kind: string): string | null {
+  return CLASS_6_7_MODEL_QUESTION_PASSAGE_PARENTS[
+    kind as keyof typeof CLASS_6_7_MODEL_QUESTION_PASSAGE_PARENTS
+  ] ?? null;
+}
+
+export function getFixedPassageLabel(kind: string): string {
+  return kind === "paragraph" ? "Unseen Passage" :
+    kind === "seen-passage-one" ? "Passage 1" : "Passage 2";
+}
+
+/** Unseen Passage is a source block, not a numbered question item.
+ * Preserve the previously agreed 1–12 question-paper numbering.
+ */
+export function getClassSixSevenQuestionNumber(kind: string): number | null {
+  if (kind === "paragraph") return null;
+  const index = CLASS_6_7_MODEL_QUESTION_KINDS.findIndex((item) => item === kind);
+  if (index < 0) return null;
+  const unseenIndex = CLASS_6_7_MODEL_QUESTION_KINDS.indexOf("paragraph");
+  return index >= unseenIndex ? index : index + 1;
+}
